# Metadata catalog (user can also switch in the web UI)
# Default: deezer (free, no API key) or spotify (requires credentials below)
DEFAULT_METADATA_PROVIDER=deezer

# Spotify (optional — only if you use catalog "spotify")
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=http://localhost:8000/callback

# Navidrome Configuration
# Single library (default when NAVIDROME_MUSIC_PATHS is unset; Docker often uses /music)
NAVIDROME_MUSIC_PATH=/path/to/navidrome/music
# Optional: multiple comma- or newline-separated absolute paths — each appears as "Download to" in the UI
# NAVIDROME_MUSIC_PATHS=/data/music/a,/data/music/b
# NAVIDROME_MUSIC_LABELS=Library A,Library B
# Optional: Navidrome API URL for triggering scans (requires admin credentials)
NAVIDROME_API_URL=http://localhost:4533
NAVIDROME_USERNAME=admin
NAVIDROME_PASSWORD=password
# Periodically scan NAVIDROME_MUSIC_PATH and mark matching catalog tracks as downloaded (SQLite)
# NAVIDROME_SYNC_ENABLED=true
# NAVIDROME_SYNC_INTERVAL_HOURS=4
# NAVIDROME_SYNC_INITIAL_DELAY_SEC=120
# NAVIDROME_SYNC_API_DELAY_SEC=0.12

# Persistent app data (auth DB, queue jobs, app settings, banned IPs).
# Default /app/data inside the container — bind-mounted to a host volume in
# docker-compose.yml so the DB survives `docker compose build --no-cache`.
# Override only for non-Docker setups (e.g. dev outside the container).
# JOBS_DB_PATH=/app/data/jobs.db

# Download Configuration
# Working directory for in-flight audio files. Separate from JOBS_DB_PATH
# on purpose — clearing this folder must NOT wipe your auth state.
DOWNLOAD_DIR=./downloads
OUTPUT_FORMAT=mp3
AUDIO_QUALITY=128
# Delay before deleting browser temp files (seconds); avoids 404 on duplicate GETs
# TEMP_FILE_CLEANUP_DELAY_SEC=60

# ─── YouTube / yt-dlp Configuration ─────────────────────────────────
# Optional: Cookies file (Netscape format). Trades anonymity for fewer
# 403/age-gate blocks. Leave empty for anonymous mode. Export via browser
# extension, NOT --cookies-from-browser (container has no browser profile).
# YOUTUBE_COOKIES_PATH=/path/to/youtube_cookies.txt

# ─── yt-dlp Anti-Detection / Rate-Limiting ───────────────────────────
# Per-download bandwidth cap (bytes/sec). 1.5 MB/s avoids the burst-pattern
# that triggers CDN anti-rip detection. Lower = stealthier, slower.
# YOUTUBE_RATELIMIT_BPS=1500000

# Random HTTP-chunk-size range per download (MB). Variation prevents
# fingerprinting Tonus across multiple downloads.
# YOUTUBE_CHUNK_MIN_MB=8
# YOUTUBE_CHUNK_MAX_MB=16

# Sleep ranges (seconds). yt-dlp randomizes between min/max — natural
# pauses, not clockwork.
# YOUTUBE_SLEEP_REQUESTS_S=1     # between API calls within a download
# YOUTUBE_SLEEP_MIN_S=5          # between fragments / retries (lower bound)
# YOUTUBE_SLEEP_MAX_S=15         # upper bound

# Browser TLS-handshake fingerprint to emulate (via curl-cffi). Massive
# impact on anti-bot resilience. Set to empty string to disable.
# Other targets: chrome, firefox, safari (yt-dlp picks the latest version
# from the available curl_cffi targets).
# YOUTUBE_IMPERSONATE=chrome

# Comma-separated player_clients yt-dlp tries in order if one fails.
# `default` triggers the bundled po_token plugin automatically.
# `tv_embedded` ist seit yt-dlp 2026 unsupported — daher raus aus default.
# YOUTUBE_PLAYER_CLIENTS=default,web,android_vr

# ─── Multi-Source-Resolver (v0.2.0+) ──────────────────────────────────
# Smart Source-Routing: jeder Track wird parallel auf allen aktivierten
# Quellen pre-searched, der best-scorende Treffer wird gepullt. Bei
# Download-Fail (z.B. YouTube Age-Gate) automatisch nächst-bester aus
# dem Ranking. Fallback ohne Cookies/Account.
#
# Reihenfolge bestimmt Priorität bei Score-Ties: bei `youtube,soundcloud`
# gewinnt YouTube wenn beide Quellen denselben Score haben. Setze
# `soundcloud,youtube` wenn du primär Auth-Friction vermeiden willst —
# dann gewinnt SoundCloud bei Tie.
#
# Bandcamp ist NICHT default: yt-dlp hat keinen 'bcsearch'-Prefix.
# Bandcamp-URLs als Direct-Download funktionieren weiter — der Resolver
# kann es aber nicht für Search-Match nutzen.
# ENABLED_SOURCES=youtube,soundcloud

# Pro-Source-Pre-Search Timeout (Sekunden). Verhindert dass eine langsame
# Quelle das Resolve blockiert.
# MULTI_SOURCE_TIMEOUT_S=10

# Minimum-Match-Score (0-1). Treffer unter dem Wert werden verworfen
# damit nicht falsche Tracks in deine Library landen.
# MULTI_SOURCE_MIN_SCORE=0.65

# Wieviele Kandidaten pro Source vor dem Ranking gezogen werden. Mehr =
# bessere Auswahl aber langsamer Pre-Search.
# MULTI_SOURCE_CANDIDATES_PER_SOURCE=3

# ─── Logging ──────────────────────────────────────────────────────────
# Level für Tonus' eigene Logger (resolver, worker, app). DEBUG | INFO |
# WARNING | ERROR | CRITICAL.
# LOG_LEVEL=INFO

# Uvicorn HTTP-Access-Logs ('GET /api/queue 200 OK'-Spam). Default OFF
# weil das UI alle 1s polled — die Spam-Lines würden den Container-Log
# überfluten und echte Resolver/Worker-Meldungen überscrollen. Auf 'true'
# setzen wenn du HTTP-Routing debuggen willst.
# UVICORN_ACCESS_LOG=false

# yt-dlp's eigenes Logging. true = nur Errors, false = alle [youtube] /
# [soundcloud] -Lines (Sleeping, Downloading, etc.). False ist gut für
# Debug, true für sauberen Container-Log in Production.
# YT_DLP_QUIET=false

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# DEPRECATED: legacy static plugin token. New installs should use Personal
# Access Tokens via Settings → API-Tokens. Only set this if you are migrating
# an existing plugin install — see README → Authentication → Migration.
# TONUS_API_TOKEN=replace-with-strong-random-string

# VPN Split for two Network-Interfaces
VPN_SPLIT_ENABLED=true
VPN_SOURCE_A=192.168.1.200
VPN_SOURCE_B=192.168.1.201