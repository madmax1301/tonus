# Metadata catalog (user can also switch in the web UI)
# Default: deezer (free, no API key) or spotify (requires credentials below)
DEFAULT_METADATA_PROVIDER=deezer

# Spotify (optional — only if you use catalog "spotify")
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=http://localhost:8000/callback

# Navidrome Configuration
# Single library (default when NAVIDROME_MUSIC_PATHS is unset; Docker often uses /music)
NAVIDROME_MUSIC_PATH=/music
# Optional: multiple comma- or newline-separated absolute paths
# NAVIDROME_MUSIC_PATHS=/data/music/a,/data/music/b
# NAVIDROME_MUSIC_LABELS=Library A,Library B
# Optional: Navidrome API URL for triggering scans (requires admin credentials)
NAVIDROME_API_URL=http://navidrome:4533
NAVIDROME_USERNAME=
NAVIDROME_PASSWORD=
# Periodically scan NAVIDROME_MUSIC_PATH and mark matching catalog tracks as downloaded
NAVIDROME_SYNC_ENABLED=true
NAVIDROME_SYNC_INTERVAL_HOURS=4
NAVIDROME_SYNC_INITIAL_DELAY_SEC=120
NAVIDROME_SYNC_API_DELAY_SEC=0.12

# Download Configuration
DOWNLOAD_DIR=/app/downloads
OUTPUT_FORMAT=opus
AUDIO_QUALITY=256
# TEMP_FILE_CLEANUP_DELAY_SEC=60

# YouTube Configuration (optional)
# YOUTUBE_COOKIES_PATH=/path/to/youtube_cookies.txt

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional Bearer-Token-Auth.
# - Empty: all endpoints are open (default; same as before).
# - Set: every mutating endpoint (POST/DELETE on /api/download*, /api/import/csv*,
#   /api/queue/*, /api/url/download) requires `Authorization: Bearer <token>`.
#   Read endpoints (queue listing, search, plugin/health, plugin/sync-status)
#   stay open so the Navidrome plugin can poll status without a token.
# Generate a strong token, e.g. `openssl rand -hex 32`.
TONUS_API_TOKEN=
